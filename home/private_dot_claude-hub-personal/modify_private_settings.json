{{- /* chezmoi:modify-template */ -}}
{{- /*
  The hub Claude profile's settings.json is a copy that
  subscription-hub-profiles.py made from ~/.claude/settings.json, plus the hub
  env; nothing refreshes it afterwards. This template passes it through
  untouched except for one strip.

  Removed 2026-11-06: the `composio execute SLACK_*` ask rules. agent-guard
  0.5.60 asks for those sends itself and lets one through without a prompt
  when Royal approved its exact text in chat; a settings ask rule would
  override that. Stripped only once the host's installed guard (its
  updater-status.json) is 0.5.60 or later; until then the file passes through.
  Same list and check as home/private_dot_claude/modify_settings.json.
*/ -}}
{{- $guardOwnsAsks := false -}}
{{- range list "/Library/Application Support/ClaudeCode/agent-guard/updater-status.json" "/etc/claude-code/agent-guard/updater-status.json" "C:/Program Files/ClaudeCode/agent-guard/updater-status.json" -}}
{{-   if stat . -}}
{{- /* Regex, not fromJson: a garbled status file must keep the asks, not abort the apply. */ -}}
{{-     $field := regexFind "\"version\"\\s*:\\s*\"[0-9]+\\.[0-9]+\\.[0-9]+\"" (include .) -}}
{{-     if $field -}}
{{-       if semverCompare ">=0.5.60" (regexFind "[0-9]+\\.[0-9]+\\.[0-9]+" $field) -}}
{{-         $guardOwnsAsks = true -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- /*
  Added 2026-11-07: sessions compact at 500K tokens, not the 1M default. The
  reason and the numbers are in home/private_dot_claude/modify_settings.json;
  keep the two values the same.
*/ -}}
{{- if not (trim .chezmoi.stdin) -}}
{{-   .chezmoi.stdin -}}
{{- else -}}
{{-   $settings := fromJson .chezmoi.stdin -}}
{{-   $_ := set $settings "autoCompactWindow" 500000 -}}
{{- /*
  Added 2026-11-25 (skills overhaul): the skill listing ceiling and the
  claude.ai synced skills hidden from the model. The reasons are in
  home/private_dot_claude/modify_settings.json; keep the value and the list
  the same in both.
*/ -}}
{{-   $_ := set $settings "skillListingBudgetFraction" 0.1 -}}
{{-   $overrides := dict -}}
{{-   if hasKey $settings "skillOverrides" -}}
{{-     $overrides = index $settings "skillOverrides" -}}
{{-   end -}}
{{-   range list "built-in-browser" "chrome-browser" "computer-use" "deep-research" "docs" "google-workspace" "import-memory" "morning" "skill-creator" -}}
{{-     if not (hasKey $overrides .) -}}
{{-       $_ := set $overrides . "user-invocable-only" -}}
{{-     end -}}
{{-   end -}}
{{-   $_ := set $settings "skillOverrides" $overrides -}}
{{- $home := replace "\\" "/" .chezmoi.homeDir -}}
{{- /*
  Added 2026-11-11: skill-router's library steer (skills/skill-router,
  library.toml). One script on SessionStart (the library card),
  UserPromptSubmit (trigger phrases such as "tell me when CI finishes") and
  PreToolUse (sleep loops, --watch polls, Monitor, ScheduleWakeup, plain ssh
  to a mesh host, transcript greps, subagent and T3 launches, and file edits:
  the first frontend edit and the library entries marked `edits`). The
  PreToolUse matcher is the frozen string from the 2026-11-25 skills
  overhaul; Codex's twin is in home/dot_codex/modify_hooks.json. It only adds
  context and never blocks.
  Present only while the skill is linked on this host. An existing entry keeps
  its place and gets the current command; a missing one is appended. Same
  block in home/private_dot_claude/modify_settings.json.
*/ -}}
{{- $lsScript := printf "%s/.agents/skills/skill-router/scripts/library_steer.py" $home -}}
{{- $lsCmd := printf "%s \"%s\" hook claude" (ternary "python" "python3" (eq .chezmoi.os "windows")) $lsScript -}}
{{- $lsHooks := dict -}}
{{- if hasKey $settings "hooks" -}}
{{-   $lsHooks = index $settings "hooks" -}}
{{- end -}}
{{- /*
  Added 2026-11-25 (skills overhaul): skill-router's hidden_skills_context.py
  is deleted; the library steer's SessionStart card now carries the hidden
  workflow list. Any hook that runs it (bouncehouse had them wired by hand)
  is removed here one hook at a time, so another hook in the same group
  (herdr) stays; a group left with no hooks is dropped.
*/ -}}
{{- range $event, $groups := $lsHooks -}}
{{-   $keptGroups := list -}}
{{-   $stripped := false -}}
{{-   range $group := $groups -}}
{{-     $groupHooks := list -}}
{{-     $stale := false -}}
{{-     range $h := (index $group "hooks") -}}
{{-       if contains "skill-router/scripts/hidden_skills_context.py" (index $h "command" | default "") -}}
{{-         $stale = true -}}
{{-       else -}}
{{-         $groupHooks = append $groupHooks $h -}}
{{-       end -}}
{{-     end -}}
{{-     if not $stale -}}
{{-       $keptGroups = append $keptGroups $group -}}
{{-     else -}}
{{-       $stripped = true -}}
{{-       if $groupHooks -}}
{{-         $_ := set $group "hooks" $groupHooks -}}
{{-         $keptGroups = append $keptGroups $group -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{-   if $stripped -}}
{{-     if $keptGroups -}}
{{-       $_ := set $lsHooks $event $keptGroups -}}
{{-     else -}}
{{-       $_ := unset $lsHooks $event -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $lsMatchers := dict "SessionStart" "" "UserPromptSubmit" "" "Stop" "" "PreToolUse" "^(Bash|PowerShell|Monitor|ScheduleWakeup|Read|Grep|Glob|mcp__t3-code__task_status|mcp__t3-code__delegate_task|mcp__t3-code__watch_pull_request|Agent|Task|Edit|Write|MultiEdit|NotebookEdit|mcp__t3-code__t3_thread_launch|mcp__t3-code__t3_thread_read)$" -}}
{{- $lsPresent := stat $lsScript -}}
{{- range $event := list "SessionStart" "UserPromptSubmit" "PreToolUse" "Stop" -}}
{{-   $lsEntry := dict "matcher" (index $lsMatchers $event) "hooks" (list (dict "type" "command" "command" $lsCmd "timeout" 10)) -}}
{{-   $kept := list -}}
{{-   $placed := false -}}
{{-   if hasKey $lsHooks $event -}}
{{-     range $group := index $lsHooks $event -}}
{{-       $mine := false -}}
{{-       range $h := (index $group "hooks") -}}
{{-         if contains "skill-router/scripts/library_steer.py" (index $h "command" | default "") -}}
{{-           $mine = true -}}
{{-         end -}}
{{-       end -}}
{{-       if not $mine -}}
{{-         $kept = append $kept $group -}}
{{-       else if and $lsPresent (not $placed) -}}
{{-         $placed = true -}}
{{-         $kept = append $kept $lsEntry -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{-   if and $lsPresent (not $placed) -}}
{{-     $kept = append $kept $lsEntry -}}
{{-   end -}}
{{-   if $kept -}}
{{-     $_ := set $lsHooks $event $kept -}}
{{-   else if hasKey $lsHooks $event -}}
{{-     $_ := unset $lsHooks $event -}}
{{-   end -}}
{{- end -}}
{{- /*
  Added 2026-11-14: Auspex held watches (harbor auspex/src/hold.rs; backlog
  01M73AKGFT3ZMNR2B8SCBVZ4S2). T3 shows a thread as waiting only while the
  session has background work marked awaited, and a watch lives in the Auspex
  daemon, so a thread that opened one looked finished. Three hooks make an
  ordinary `auspex watch` call hold the watch in a background task with no
  step by the agent:
  - PreToolUse (auspex hook claude pre) rewrites a Bash call holding one
    `auspex watch` to `auspex hold ...`, run in the background;
  - PostToolUse (auspex hook claude post) tells the agent the watch id;
  - PostToolUse mcp_tool calls T3's t3_background_wait with the new task id,
    through the session's own T3 connection; outside T3 there is no t3-code
    server and Claude skips it.
  Each command ends in `|| true`: an older auspex without `hook` exits 2,
  which would block the call, until own-tools-sync installs the new one.
  The `if` filters fire on any compound command too, which is harmless: the
  pre hook leaves other calls alone, and t3_background_wait without a task id
  matches nothing. Present only while an auspex binary is installed. Existing
  entries are replaced in place, missing ones appended. Same block in
  home/private_dot_claude/modify_settings.json.
*/ -}}
{{- $axExe := "" -}}
{{- range list (printf "%s/.cargo/bin/auspex" $home) (printf "%s/.cargo/bin/auspex.exe" $home) (printf "%s/.local/bin/auspex" $home) (printf "%s/.local/bin/auspex.exe" $home) -}}
{{-   if and (not $axExe) (stat .) -}}
{{-     $axExe = . -}}
{{-   end -}}
{{- end -}}
{{- if not $axExe -}}
{{-   $axExe = lookPath "auspex" | default "" | replace "\\" "/" -}}
{{- end -}}
{{- $axEntries := dict -}}
{{- if $axExe -}}
{{-   $axCmd := printf "\"%s\" hook claude" $axExe -}}
{{-   $axPre := dict "matcher" "^Bash$" "hooks" (list (dict "type" "command" "command" (printf "%s pre || true" $axCmd) "if" "Bash(*auspex watch*)" "timeout" 5)) -}}
{{-   $axWait := dict "type" "mcp_tool" "server" "t3-code" "tool" "t3_background_wait" "input" (dict "taskIds" (list "${tool_response.backgroundTaskId}")) "if" "Bash(*auspex* hold *)" "timeout" 15 -}}
{{-   $axPost := dict "matcher" "^Bash$" "hooks" (list (dict "type" "command" "command" (printf "%s post || true" $axCmd) "if" "Bash(*auspex* hold *)" "timeout" 10) $axWait) -}}
{{-   $axEntries = dict "PreToolUse" $axPre "PostToolUse" $axPost -}}
{{- end -}}
{{- range $event := list "PreToolUse" "PostToolUse" -}}
{{-   $kept := list -}}
{{-   $placed := false -}}
{{-   if hasKey $lsHooks $event -}}
{{-     range $group := index $lsHooks $event -}}
{{-       $mine := false -}}
{{-       range $h := (index $group "hooks") -}}
{{-         if or (and (contains "auspex" (index $h "command" | default "")) (contains "hook claude" (index $h "command" | default ""))) (eq (index $h "tool" | default "") "t3_background_wait") -}}
{{-           $mine = true -}}
{{-         end -}}
{{-       end -}}
{{-       if not $mine -}}
{{-         $kept = append $kept $group -}}
{{-       else if and (hasKey $axEntries $event) (not $placed) -}}
{{-         $placed = true -}}
{{-         $kept = append $kept (index $axEntries $event) -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{-   if and (hasKey $axEntries $event) (not $placed) -}}
{{-     $kept = append $kept (index $axEntries $event) -}}
{{-   end -}}
{{-   if $kept -}}
{{-     $_ := set $lsHooks $event $kept -}}
{{-   else if hasKey $lsHooks $event -}}
{{-     $_ := unset $lsHooks $event -}}
{{-   end -}}
{{- end -}}
{{- if $lsHooks -}}
{{-   $_ := set $settings "hooks" $lsHooks -}}
{{- end -}}
{{- /*
  Added 2026-11-27: Harbor's slow-turn-retro Stop hook
  (~/.harbor/current/tools/slow_turn_retro.py). Present only while Harbor's
  deployed copy exists. Same block in
  home/private_dot_claude/modify_settings.json.
*/ -}}
{{- $strScript := printf "%s/.harbor/current/tools/slow_turn_retro.py" $home -}}
{{- $strCmd := printf "%s \"%s\" hook claude" (ternary "python" "python3" (eq .chezmoi.os "windows")) $strScript -}}
{{- $strPresent := stat $strScript -}}
{{- $strEntry := dict "matcher" "" "hooks" (list (dict "type" "command" "command" $strCmd "timeout" 15)) -}}
{{- $strKept := list -}}
{{- $strPlaced := false -}}
{{- if hasKey $lsHooks "Stop" -}}
{{-   range $group := index $lsHooks "Stop" -}}
{{-     $mine := false -}}
{{-     range $h := (index $group "hooks") -}}
{{-       if contains "tools/slow_turn_retro.py" (index $h "command" | default "") -}}
{{-         $mine = true -}}
{{-       end -}}
{{-     end -}}
{{-     if not $mine -}}
{{-       $strKept = append $strKept $group -}}
{{-     else if and $strPresent (not $strPlaced) -}}
{{-       $strPlaced = true -}}
{{-       $strKept = append $strKept $strEntry -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- if and $strPresent (not $strPlaced) -}}
{{-   $strKept = append $strKept $strEntry -}}
{{- end -}}
{{- if $strKept -}}
{{-   $_ := set $lsHooks "Stop" $strKept -}}
{{- else if hasKey $lsHooks "Stop" -}}
{{-   $_ := unset $lsHooks "Stop" -}}
{{- end -}}
{{- if $lsHooks -}}
{{-   $_ := set $settings "hooks" $lsHooks -}}
{{- end -}}
{{-   if not $guardOwnsAsks -}}
{{-     toPrettyJson $settings | trim -}}
{{-   else -}}
{{-   $guardAsks := list "Bash(composio execute SLACK_SEND_MESSAGE:*)" "Bash(composio execute SLACK_CHAT_POST_MESSAGE:*)" "Bash(composio execute SLACK_SEND_ME_MESSAGE:*)" "Bash(composio execute SLACK_SEND_EPHEMERAL_MESSAGE:*)" "Bash(composio execute SLACK_SCHEDULE_MESSAGE:*)" "Bash(composio execute SLACK_UPLOAD_OR_CREATE_A_FILE_IN_SLACK:*)" "Bash(composio execute SLACK_ADD_REACTION_TO_AN_ITEM:*)" -}}
{{-   if and (hasKey $settings "permissions") (hasKey (index $settings "permissions") "ask") -}}
{{-     $perms := index $settings "permissions" -}}
{{-     $cur := list -}}
{{-     range (index $perms "ask") -}}
{{-       if not (has . $guardAsks) -}}
{{-         $cur = append $cur . -}}
{{-       end -}}
{{-     end -}}
{{-     $_ := set $perms "ask" $cur -}}
{{-   end -}}
{{-   toPrettyJson $settings | trim -}}
{{-   end -}}
{{- end -}}
