{{- /* chezmoi:modify-template */ -}}
{{- /*
  Kept identical in dot_codex/ and dot_codex-work/ (modify templates cannot
  include .chezmoitemplates).
  Codex owns hooks.json (Telepathica, run-meter and Lore installers write it),
  so this passes every entry through and only adds or removes the full-send
  skill's `.stop` hook (skills/full-send, references/stop.md) on
  UserPromptSubmit, PreToolUse and Stop, and skill-router's library steer on
  SessionStart, UserPromptSubmit and PreToolUse. Codex keys hook trust by position, so
  an existing entry keeps its place (only its content is refreshed) and a
  missing one is appended. Telepathica's installer moves its own entries to the
  end; if this template also moved ours, the two would leapfrog and every swap
  would void the trust of both (seen 2026-10-20).
  Present only while the skill is linked on this host: a missing script exits
  2, which blocks the prompt. Codex runs a new hook only after it is trusted
  once in the TUI (/hooks). With nothing to add or remove, the file passes
  through byte for byte; once the entries are added, the file is rewritten
  with sorted keys (event arrays keep their order).
*/ -}}
{{- $doc := dict -}}
{{- if trim .chezmoi.stdin -}}
{{-   $doc = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $home := replace "\\" "/" .chezmoi.homeDir -}}
{{- $fsScript := printf "%s/.agents/skills/full-send/scripts/ship_verbs.py" $home -}}
{{- $fsCmd := printf "%s \"%s\" hook codex" (ternary "python" "python3" (eq .chezmoi.os "windows")) $fsScript -}}
{{- $changed := false -}}
{{- $hooks := dict -}}
{{- if hasKey $doc "hooks" -}}
{{-   $hooks = index $doc "hooks" -}}
{{- end -}}
{{- $present := stat $fsScript -}}
{{- $entry := dict "matcher" "" "hooks" (list (dict "type" "command" "command" $fsCmd "timeout" 15)) -}}
{{- range $event := list "UserPromptSubmit" "PreToolUse" "Stop" -}}
{{-   $kept := list -}}
{{-   $placed := false -}}
{{-   if hasKey $hooks $event -}}
{{-     range $group := index $hooks $event -}}
{{-       $mine := false -}}
{{-       range $h := (index $group "hooks") -}}
{{-         if contains "full-send/scripts/ship_verbs.py" (index $h "command" | default "") -}}
{{-           $mine = true -}}
{{-         end -}}
{{-       end -}}
{{-       if not $mine -}}
{{-         $kept = append $kept $group -}}
{{-       else if and $present (not $placed) -}}
{{-         $placed = true -}}
{{-         if ne (toJson $group) (toJson $entry) -}}
{{-           $changed = true -}}
{{-         end -}}
{{-         $kept = append $kept $entry -}}
{{-       else -}}
{{-         $changed = true -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{-   if and $present (not $placed) -}}
{{-     $changed = true -}}
{{-     $kept = append $kept $entry -}}
{{-   end -}}
{{-   if $kept -}}
{{-     $_ := set $hooks $event $kept -}}
{{-   else if hasKey $hooks $event -}}
{{-     $_ := unset $hooks $event -}}
{{-   end -}}
{{- end -}}
{{- /*
  Added 2026-11-11: skill-router's library steer (skills/skill-router,
  library.toml) on SessionStart, UserPromptSubmit and PreToolUse (shell calls
  only). It only adds context. Same position rules as the full-send entry above;
  Harbor's tools/codex_hook_trust.py records its trust on rollout.
*/ -}}
{{- $lsScript := printf "%s/.agents/skills/skill-router/scripts/library_steer.py" $home -}}
{{- $lsCmd := printf "%s \"%s\" hook codex" (ternary "python" "python3" (eq .chezmoi.os "windows")) $lsScript -}}
{{- $lsPresent := stat $lsScript -}}
{{- $lsMatchers := dict "SessionStart" "" "UserPromptSubmit" "" "PreToolUse" "^(Bash|PowerShell|exec_command|shell|shell_command|local_shell|unified_exec|collaborationspawn_agent)$" -}}
{{- range $event := list "SessionStart" "UserPromptSubmit" "PreToolUse" -}}
{{-   $lsEntry := dict "matcher" (index $lsMatchers $event) "hooks" (list (dict "type" "command" "command" $lsCmd "timeout" 10)) -}}
{{-   $kept := list -}}
{{-   $placed := false -}}
{{-   if hasKey $hooks $event -}}
{{-     range $group := index $hooks $event -}}
{{-       $mine := false -}}
{{-       range $h := (index $group "hooks") -}}
{{-         if contains "skill-router/scripts/library_steer.py" (index $h "command" | default "") -}}
{{-           $mine = true -}}
{{-         end -}}
{{-       end -}}
{{-       if not $mine -}}
{{-         $kept = append $kept $group -}}
{{-       else if and $lsPresent (not $placed) -}}
{{-         $placed = true -}}
{{-         if ne (toJson $group) (toJson $lsEntry) -}}
{{-           $changed = true -}}
{{-         end -}}
{{-         $kept = append $kept $lsEntry -}}
{{-       else -}}
{{-         $changed = true -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{-   if and $lsPresent (not $placed) -}}
{{-     $changed = true -}}
{{-     $kept = append $kept $lsEntry -}}
{{-   end -}}
{{-   if $kept -}}
{{-     $_ := set $hooks $event $kept -}}
{{-   else if hasKey $hooks $event -}}
{{-     $_ := unset $hooks $event -}}
{{-   end -}}
{{- end -}}
{{- if $changed -}}
{{-   $_ := set $doc "hooks" $hooks -}}
{{-   toPrettyJson $doc | trim }}
{{- else -}}
{{-   .chezmoi.stdin -}}
{{- end -}}
