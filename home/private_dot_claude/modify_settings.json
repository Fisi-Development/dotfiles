{{- /* chezmoi:modify-template */ -}}
{{- /*
  Claude Code owns ~/.claude/settings.json and rewrites it constantly (plugins,
  hooks, effort level), so the file stays machine-local. This template passes
  every key through untouched except the one it strips below.

  Removed 2026-10-08: modelSettings.claude-haiku-5-5.autoCompactWindow (100000).
  It had pinned Haiku 5.5 to compact at 100K tokens, because the API price steps
  up above 100K-token prompts. That compaction thrashed a delegated Haiku worker
  that read a few large files (three compacts in three turns, then the run died),
  so Royal chose to drop the cap and accept the higher per-token price past 100K.
  The template now deletes the key so every host converges on the next apply.
  Delete this template once all hosts have applied it.
*/ -}}
{{- $settings := dict -}}
{{- if trim .chezmoi.stdin -}}
{{-   $settings = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- if hasKey $settings "modelSettings" -}}
{{-   $ms := index $settings "modelSettings" -}}
{{-   if hasKey $ms "claude-haiku-5-5" -}}
{{-     $h := index $ms "claude-haiku-5-5" -}}
{{-     $_ := unset $h "autoCompactWindow" -}}
{{-     if not $h -}}
{{-       $_ := unset $ms "claude-haiku-5-5" -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- /*
  Added 2026-10-08: outbound messages always ask. Scheduled sweeps (inbox-sweep)
  read Slack and Gmail unattended; an ask rule stops any send there for a human,
  instead of relying on hooks or the auto-mode classifier.
  Added 2026-10-14: work Slack moved to Composio (slack-composio skill), so its
  send, schedule, upload and reaction slugs, and composio proxy and run, ask too.
  Moved 2026-11-06: the `composio execute SLACK_*` asks now come from
  agent-guard 0.5.60, which lets a send through without a prompt when Royal
  approved its exact text in chat and asks otherwise. A settings ask rule
  overrides a hook's allow, so these entries are stripped below once the host's
  installed guard (its updater-status.json) is 0.5.60 or later, and kept until
  then. composio proxy and run still ask here.
*/ -}}
{{- $ask := list "mcp__plugin_slack_slack__slack_send_message" "mcp__plugin_slack_slack__slack_schedule_message" "Bash(gws gmail users messages send:*)" "Bash(gws gmail users drafts send:*)" "Bash(composio proxy:*)" "Bash(composio run:*)" -}}
{{- $perms := dict -}}
{{- if hasKey $settings "permissions" -}}
{{-   $perms = index $settings "permissions" -}}
{{- end -}}
{{- /*
  Removed 2026-10-15: the Ramp MCP (added 2026-10-14) needs Ramp Plus, which
  FISI does not have. Its mcp__ramp__ ask rules are stripped so every host
  converges; drop this pass once all hosts have applied it.
*/ -}}
{{- $guardAsks := list "Bash(composio execute SLACK_SEND_MESSAGE:*)" "Bash(composio execute SLACK_CHAT_POST_MESSAGE:*)" "Bash(composio execute SLACK_SEND_ME_MESSAGE:*)" "Bash(composio execute SLACK_SEND_EPHEMERAL_MESSAGE:*)" "Bash(composio execute SLACK_SCHEDULE_MESSAGE:*)" "Bash(composio execute SLACK_UPLOAD_OR_CREATE_A_FILE_IN_SLACK:*)" "Bash(composio execute SLACK_ADD_REACTION_TO_AN_ITEM:*)" -}}
{{- $guardOwnsAsks := false -}}
{{- range list "/Library/Application Support/ClaudeCode/agent-guard/updater-status.json" "/etc/claude-code/agent-guard/updater-status.json" "C:/Program Files/ClaudeCode/agent-guard/updater-status.json" -}}
{{-   if stat . -}}
{{- /* Regex, not fromJson: a garbled status file must keep the asks, not abort the apply. */ -}}
{{-     $field := regexFind "\"version\"\\s*:\\s*\"[0-9]+\\.[0-9]+\\.[0-9]+\"" (include .) -}}
{{-     if $field -}}
{{-       if semverCompare ">=0.5.60" (regexFind "[0-9]+\\.[0-9]+\\.[0-9]+" $field) -}}
{{-         $guardOwnsAsks = true -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- if not $guardOwnsAsks -}}
{{-   $ask = concat $ask $guardAsks -}}
{{- end -}}
{{- $cur := list -}}
{{- if hasKey $perms "ask" -}}
{{-   range (index $perms "ask") -}}
{{-     if not (or (hasPrefix "mcp__ramp__" .) (and $guardOwnsAsks (has . $guardAsks))) -}}
{{-       $cur = append $cur . -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- range $ask -}}
{{-   if not (has . $cur) -}}
{{-     $cur = append $cur . -}}
{{-   end -}}
{{- end -}}
{{- $_ := set $perms "ask" $cur -}}
{{- /*
  Added 2026-10-13: Telepathica's commands that carry no message body run
  without the auto-mode classifier, which had denied `telepathica archive` as
  [External System Writes] when Royal's request was general ("archive
  everything that's done"). send, notify, reply, release and shell loops stay
  with the classifier, which reads "Telepathica commands" in
  ~/.agents/authorization-policy.md. The Codex twin is
  ~/.codex/rules/telepathica.rules.
*/ -}}
{{- $tbins := list "telepathica" "telepathica.exe" "telepathica.EXE" "~/.local/bin/telepathica" -}}
{{- $home := replace "\\" "/" .chezmoi.homeDir -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   range $exe := list "telepathica.exe" "telepathica.EXE" -}}
{{-     $p := printf "%s/.local/bin/%s" $home $exe -}}
{{-     $tbins = concat $tbins (list $p (replace "/" "\\" $p)) -}}
{{-   end -}}
{{- else -}}
{{-   $tbins = append $tbins (printf "%s/.local/bin/telepathica" $home) -}}
{{- end -}}
{{- $allow := list -}}
{{- if hasKey $perms "allow" -}}
{{-   $allow = index $perms "allow" -}}
{{- end -}}
{{- range $tool := list "Bash" "PowerShell" -}}
{{-   range $bin := $tbins -}}
{{-     range $sub := list "find" "inbox" "thread" "whoami" "ack" "archive" -}}
{{-       $rule := printf "%s(%s %s:*)" $tool $bin $sub -}}
{{-       if not (has $rule $allow) -}}
{{-         $allow = append $allow $rule -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $_ := set $perms "allow" $allow -}}
{{- $_ := set $settings "permissions" $perms -}}
{{- /*
  Added 2026-10-18 (tool-call audit): hook timeouts and the Lore bridge move.

  Every command hook without a timeout gets one, so a wedged hook cannot hold
  a turn for Claude Code's 600 s default: 600 for PermissionRequest (it may
  wait on a person, so its behavior is unchanged), 30 for everything else.

  Windows: since 2026-10-16 C:\Users\gwmai\git is a Dev Drive volume mount.
  The Harbor Lore bridge refuses any reparse-point parent, so its release under
  git\harbor\.local\lore-hooks failed on every hook call. Its release now lives,
  byte for byte, under ~/.harbor/lore-hooks (Harbor tools/stage_lore_hooks.py).
  The hook command carries the path inside a Base64 loader, so this decodes the
  loader, swaps the path and re-encodes it, only once the new release exists.
*/ -}}
{{- $loreOld := `C:\Users\gwmai\git\harbor\.local\lore-hooks\` -}}
{{- $loreNew := `C:\Users\gwmai\.harbor\lore-hooks\` -}}
{{- $loreMoved := and (eq .chezmoi.os "windows") (stat (joinPath .chezmoi.homeDir ".harbor" "lore-hooks")) -}}
{{- if hasKey $settings "hooks" -}}
{{-   range $event, $groups := index $settings "hooks" -}}
{{-     range $group := $groups -}}
{{-       range $hook := (index $group "hooks") -}}
{{-         if eq (index $hook "type" | default "command") "command" -}}
{{-           if not (hasKey $hook "timeout") -}}
{{-             $_ := set $hook "timeout" (ternary 600 30 (eq $event "PermissionRequest")) -}}
{{-           end -}}
{{-           $cmd := index $hook "command" | default "" -}}
{{-           if and $loreMoved (contains "FromBase64String('" $cmd) -}}
{{-             $b64 := regexReplaceAll `(?s)^.*FromBase64String\('([A-Za-z0-9+/=]+)'\).*$` $cmd "${1}" -}}
{{-             $loader := b64dec $b64 -}}
{{-             if contains $loreOld $loader -}}
{{-               $_ := set $hook "command" (replace $b64 (b64enc (replace $loreOld $loreNew $loader)) $cmd) -}}
{{-             end -}}
{{-           end -}}
{{-         end -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- /*
  Added 2026-10-20: the full-send skill's `.stop` hook (skills/full-send,
  references/stop.md). One script on UserPromptSubmit, PreToolUse and Stop.
  Present only while the skill is linked on this host: a hook whose script is
  missing would exit 2, and exit 2 blocks every prompt. An existing entry keeps
  its place and gets the current command; a missing one is appended.
*/ -}}
{{- $fsScript := printf "%s/.agents/skills/full-send/scripts/ship_verbs.py" $home -}}
{{- $fsCmd := printf "%s \"%s\" hook claude" (ternary "python" "python3" (eq .chezmoi.os "windows")) $fsScript -}}
{{- $fsHooks := dict -}}
{{- if hasKey $settings "hooks" -}}
{{-   $fsHooks = index $settings "hooks" -}}
{{- end -}}
{{- $fsEntry := dict "matcher" "" "hooks" (list (dict "type" "command" "command" $fsCmd "timeout" 15)) -}}
{{- $fsPresent := stat $fsScript -}}
{{- range $event := list "UserPromptSubmit" "PreToolUse" "Stop" -}}
{{-   $kept := list -}}
{{-   $placed := false -}}
{{-   if hasKey $fsHooks $event -}}
{{-     range $group := index $fsHooks $event -}}
{{-       $mine := false -}}
{{-       range $h := (index $group "hooks") -}}
{{-         if contains "full-send/scripts/ship_verbs.py" (index $h "command" | default "") -}}
{{-           $mine = true -}}
{{-         end -}}
{{-       end -}}
{{-       if not $mine -}}
{{-         $kept = append $kept $group -}}
{{-       else if and $fsPresent (not $placed) -}}
{{-         $placed = true -}}
{{-         $kept = append $kept $fsEntry -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{-   if and $fsPresent (not $placed) -}}
{{-     $kept = append $kept $fsEntry -}}
{{-   end -}}
{{-   if $kept -}}
{{-     $_ := set $fsHooks $event $kept -}}
{{-   else if hasKey $fsHooks $event -}}
{{-     $_ := unset $fsHooks $event -}}
{{-   end -}}
{{- end -}}
{{- if $fsHooks -}}
{{-   $_ := set $settings "hooks" $fsHooks -}}
{{- end -}}
{{- /*
  Added 2026-11-11: skill-router's library steer (skills/skill-router,
  library.toml). One script on SessionStart (the library card),
  UserPromptSubmit (trigger phrases such as "tell me when CI finishes") and
  PreToolUse (sleep loops, --watch polls, Monitor, ScheduleWakeup, plain ssh
  to a mesh host, transcript greps). It only adds context and never blocks.
  Present only while the skill is linked on this host. An existing entry keeps
  its place and gets the current command; a missing one is appended. Same
  block in home/private_dot_claude-hub-personal/modify_private_settings.json.
*/ -}}
{{- $lsScript := printf "%s/.agents/skills/skill-router/scripts/library_steer.py" $home -}}
{{- $lsCmd := printf "%s \"%s\" hook claude" (ternary "python" "python3" (eq .chezmoi.os "windows")) $lsScript -}}
{{- $lsHooks := dict -}}
{{- if hasKey $settings "hooks" -}}
{{-   $lsHooks = index $settings "hooks" -}}
{{- end -}}
{{- $lsMatchers := dict "SessionStart" "" "UserPromptSubmit" "" "PreToolUse" "^(Bash|PowerShell|Monitor|ScheduleWakeup|Read|Grep|Glob|mcp__t3-code__task_status|Agent|Task)$" -}}
{{- $lsPresent := stat $lsScript -}}
{{- range $event := list "SessionStart" "UserPromptSubmit" "PreToolUse" -}}
{{-   $lsEntry := dict "matcher" (index $lsMatchers $event) "hooks" (list (dict "type" "command" "command" $lsCmd "timeout" 10)) -}}
{{-   $kept := list -}}
{{-   $placed := false -}}
{{-   if hasKey $lsHooks $event -}}
{{-     range $group := index $lsHooks $event -}}
{{-       $mine := false -}}
{{-       range $h := (index $group "hooks") -}}
{{-         if contains "skill-router/scripts/library_steer.py" (index $h "command" | default "") -}}
{{-           $mine = true -}}
{{-         end -}}
{{-       end -}}
{{-       if not $mine -}}
{{-         $kept = append $kept $group -}}
{{-       else if and $lsPresent (not $placed) -}}
{{-         $placed = true -}}
{{-         $kept = append $kept $lsEntry -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{-   if and $lsPresent (not $placed) -}}
{{-     $kept = append $kept $lsEntry -}}
{{-   end -}}
{{-   if $kept -}}
{{-     $_ := set $lsHooks $event $kept -}}
{{-   else if hasKey $lsHooks $event -}}
{{-     $_ := unset $lsHooks $event -}}
{{-   end -}}
{{- end -}}
{{- if $lsHooks -}}
{{-   $_ := set $settings "hooks" $lsHooks -}}
{{- end -}}
{{- /*
  Added 2026-10-29 (skill visibility audit): the AWS agent skills installed on
  2026-10-19 carry about 18,000 of the 36,000 description characters in Claude
  Code's skill listing, which pushed Royal's own skills (own-tools-sync,
  model-swap, supervise-run, bosun-loop and others) to name-only, so they
  stopped triggering. These stay listed by name; a skill named here that a host
  does not install costs nothing. A value Royal set by hand is kept.
  2026-11-02 (skill-doctor Review 4): the $awsOff names loaded in no Mac session
  in 30 days, so Royal turned them off; "off" replaces the name-only this
  template wrote earlier, and any other value is still kept.
*/ -}}
{{- $awsNames := list "aws-billing-and-cost-management" "aws-cloudformation" "aws-compute" "aws-iam" "aws-networking" "aws-observability" "aws-sdk-python-usage" "aws-storage" -}}
{{- $awsOff := list "amazon-bedrock" "aws-ai-ml" "aws-auth" "aws-blocks" "aws-cdk" "aws-containers" "aws-database" "aws-deployment" "aws-messaging-and-streaming" "aws-sdk-js-v3-usage" "aws-sdk-swift-usage" "aws-security" "aws-serverless" "aws-well-architected-review" "launch-with-aws" -}}
{{- $overrides := dict -}}
{{- if hasKey $settings "skillOverrides" -}}
{{-   $overrides = index $settings "skillOverrides" -}}
{{- end -}}
{{- range $awsNames -}}
{{-   if not (hasKey $overrides .) -}}
{{-     $_ := set $overrides . "name-only" -}}
{{-   end -}}
{{- end -}}
{{- range $awsOff -}}
{{-   if or (not (hasKey $overrides .)) (eq (index $overrides .) "name-only") -}}
{{-     $_ := set $overrides . "off" -}}
{{-   end -}}
{{- end -}}
{{- $_ := set $settings "skillOverrides" $overrides -}}
{{- /*
  Added 2026-11-07 (token-spend study): sessions compact at 500K tokens, not the
  1M default. 62% of fleet Claude cost proxy sat in sessions averaging over 200K
  context per call, and cache reads were 70% of it. A replay of burnbutu's 30
  days of calls priced this at about 14% less Claude cost with about 46 extra
  compactions a month (300K: 26% and 193). Royal picked 500K the same day. The
  Haiku 100K cap removed on 2026-10-08 thrashed a worker that read large files,
  so keep any lower window well above one turn's reads. A per-model value under
  modelSettings (what /autocompact saves) still wins over this one. Same value in
  home/private_dot_claude-hub-personal/modify_private_settings.json.
*/ -}}
{{- $_ := set $settings "autoCompactWindow" 500000 -}}
{{- toPrettyJson $settings | trim }}
