if [ -d "$HOME/.cargo/bin" ]; then
    case ":$PATH:" in
        *":$HOME/.cargo/bin:"*) ;;
        *) PATH="$HOME/.cargo/bin${PATH:+:$PATH}" ;;
    esac
fi
# Royal's own CLIs (telepathica, lore, agent-traces). .zprofile resets PATH from
# /etc/profile and re-sources this file, so a `zsh -lc` command (Codex, T3) only
# finds them when they are added here, not just in the interactive .zshrc.
if [ -d "$HOME/.local/bin" ]; then
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) ;;
        *) PATH="$HOME/.local/bin${PATH:+:$PATH}" ;;
    esac
fi
if [[ $(uname) == Darwin && -d "/Library/Application Support/Harbor/purser" ]]; then
    case ":$PATH:" in
        *":/Library/Application Support/Harbor/purser:"*) ;;
        *) PATH="${PATH:+$PATH:}/Library/Application Support/Harbor/purser" ;;
    esac
fi
export PATH

# Agent harnesses write bash. With fish as the login shell, Claude Code and
# Codex fall back to zsh and run each command as `zsh -c`; OpenCode does too.
# Give those command strings bash's word splitting and glob handling. An
# interactive zsh and a zsh script file keep zsh semantics.
if [[ ! -o interactive && -n $ZSH_EXECUTION_STRING ]] &&
    [[ -n $CLAUDECODE || -n $CODEX_THREAD_ID || -n $OPENCODE ]]; then
    setopt sh_word_split no_nomatch no_equals
fi
