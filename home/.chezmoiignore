# fisher-managed plugin files — installed by run_onchange_after_install-fish-plugins.sh
# from fish_plugins (the single source of truth), NOT tracked by chezmoi. Tracking
# them caused "file already exists" conflicts when fisher ran on a fresh machine.
.config/fish/functions
.config/fish/completions
.config/fish/conf.d/__async_prompt.fish
.config/fish/conf.d/autopair.fish
.config/fish/conf.d/fzf.fish
.config/fish/conf.d/nvm.fish

{{ if not (stat (joinPath .chezmoi.homeDir ".codex-work")) }}
# The work Codex login lives only where ~/.codex-work exists (not this
# desktop); its rules come from .chezmoitemplates/telepathica.rules.
.codex-work
{{ end }}

{{ if ne .chezmoi.os "darwin" }}
# --- non-macOS ---------------------------------------------------------------
# dot_zshrc and dot_zprofile are macOS-authored: they hardcode /Users/royalaid,
# oh-my-zsh, iTerm2 and a stable-x86_64-apple-darwin rust toolchain. The Linux
# and WSL homes have their own independently written .zshrc (linuxbrew, bun,
# fnm, asdf), so applying the macOS one would clobber it. fish is the login
# shell on those hosts, making zsh vestigial there — but vestigial is not the
# same as disposable, so keep the live file rather than overwrite it.
.zshrc
.zprofile
.zshenv
# dot_bashrc is macOS-authored too (it sources broot from ~/Library and adds
# /Users/royalaid paths), so a Linux host keeps its own .bashrc.
.bashrc
{{ end }}

{{ if eq .chezmoi.os "darwin" }}
# --- macOS -------------------------------------------------------------------
# Managed source tip is the Windows Codex config (daybreak model, Windows
# hooks/projects). This Mac runs gpt-5.6-sol via cliproxyapi with a divergent
# hook/plugin set. Applying the Windows file would clobber it; templating
# per-OS belongs in a follow-up. Keep the live Mac file unmanaged for now.
.codex/config.toml
{{ end }}

{{ if eq .chezmoi.os "windows" }}
# --- Windows -----------------------------------------------------------------
# Unix-only surface. Windows keeps its equivalents elsewhere: Neovim reads
# %LOCALAPPDATA%\nvim, PowerShell reads Documents\PowerShell, and there is no
# fish, tmux or fontconfig here. What Windows DOES share with the Unix hosts is
# the shared AGENTS.md, agent entry points, and
# .gitconfig, which is templated per OS — so none of those are listed here.
.bashrc
.config/fish
.config/fontconfig
.config/nvim
.fonts
.gvimrc
.vimrc
.local
.tmux.conf
install-fish-plugins.sh
{{ end }}

{{ if not (stat (joinPath .chezmoi.homeDir ".grok" "hooks" "lore.json")) }}
# Grok's Lore hook file exists only where Harbor's stager installed it (the desktop).
.grok
{{ end }}

# DigitalOcean MCP wrapper: one per OS family.
{{ if eq .chezmoi.os "windows" }}
.agents/bin/do-mcp
{{ else }}
.agents/bin/do-mcp.cmd
{{ end }}

# Dev Drive package stores: only DESKTOP-O91444G has the Dev Drive (~/git/.stores).
# On plain NTFS clone-or-copy is slower than pnpm's default, so every other host
# (Mercury, the Mac) gets neither the pnpm rc nor the store environment script.
{{ if ne .chezmoi.hostname "DESKTOP-O91444G" }}
AppData/Local/pnpm
{{ end }}

{{ if not (stat (joinPath .chezmoi.homeDir ".codex" "hooks.json")) }}
# Codex hooks.json is Codex's own file; the full-send hook is merged into it
# only where Codex already wrote one.
.codex/hooks.json
{{ end }}
{{ if not (stat (joinPath .chezmoi.homeDir ".codex-work" "hooks.json")) }}
.codex-work/hooks.json
{{ end }}
{{ if not (stat (joinPath .chezmoi.homeDir ".agents" "skills" "full-send" "plugins" "opencode" "full-send.js")) }}
# The full-send OpenCode plugin link waits until the skill is linked here.
.config/opencode/plugins/full-send.js
{{ end }}

{{ if ne .chezmoi.os "linux" }}
# Go reads ~/.config/go/env only on Linux. There GOTMPDIR moves go's work dirs and link
# output off /tmp, a small tmpfs with a per-user quota on burnbutu; Harbor's janitor
# sweeps stale entries in ~/.cache/harbor-build/tmp (docs/runbooks/janitor.md).
.config/go
.cache/harbor-build
{{ end }}
